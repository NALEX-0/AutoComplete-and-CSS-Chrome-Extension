{
    "manifest_version": 3,
    "name": "Entry AutoComplete",
    "description": "Auto complete and CSS injector",
    "version": "1.0",
    "permissions": ["storage", "tabs"],
    "action": {
      "default_popup": "popup.html"
    },
    "icons": {
      "16": "order.png",
      "48": "order.png",
      "128": "order.png"
    },
    "content_scripts": [
      {
        "matches": [
            "https://entryshop.gr/index.php?route=extension/quickcheckout/checkout",
            "https://alora.gr/index.php?route=extension/quickcheckout/checkout",
            "https://entry.com.gr/index.php?route=extension/quickcheckout/checkout",
            "https://telestore.gr/index.php?route=extension/quickcheckout/checkout",
            "https://dook.gr/index.php?route=extension/quickcheckout/checkout",
            "https://ornazo.gr/index.php?route=extension/quickcheckout/checkout"
        ],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ]
  }
  